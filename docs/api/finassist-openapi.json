{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Finance Assistant",
    "description": "A modular API foundation for an AI-powered finance assistant.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/query": {
      "post": {
        "tags": [
          "assistant"
        ],
        "summary": "Query Assistant",
        "operationId": "query_assistant_query_post",
        "parameters": [
          {
            "name": "X-Portfolio-Manager",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Local simulated manager selection; unavailable outside local mode.",
              "title": "X-Portfolio-Manager"
            },
            "description": "Local simulated manager selection; unavailable outside local mode."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/query/resume": {
      "post": {
        "tags": [
          "assistant"
        ],
        "summary": "Resume Query",
        "operationId": "resume_query_query_resume_post",
        "parameters": [
          {
            "name": "X-Portfolio-Manager",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Local simulated manager selection; unavailable outside local mode.",
              "title": "X-Portfolio-Manager"
            },
            "description": "Local simulated manager selection; unavailable outside local mode."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/portfolio/managers": {
      "get": {
        "tags": [
          "assistant"
        ],
        "summary": "Portfolio Managers",
        "operationId": "portfolio_managers_portfolio_managers_get",
        "parameters": [
          {
            "name": "X-Portfolio-Manager",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Local simulated manager selection; unavailable outside local mode.",
              "title": "X-Portfolio-Manager"
            },
            "description": "Local simulated manager selection; unavailable outside local mode."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioManagerDirectory"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse"
      },
      "QueryRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Query"
          },
          "user_role": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "portfolio_manager",
                  "individual_customer"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "User Role"
          },
          "customer_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Id"
          },
          "manager_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Manager Id"
          },
          "market_scope": {
            "anyOf": [
              {
                "const": "us_nasdaq_usd",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Market Scope"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "QueryRequest"
      },
      "QueryResponse": {
        "properties": {
          "intent": {
            "type": "string",
            "enum": [
              "finance_qa",
              "portfolio",
              "market",
              "goals",
              "news",
              "tax",
              "clarify",
              "other"
            ],
            "title": "Intent"
          },
          "classified_intent": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "finance_qa",
                  "portfolio",
                  "market",
                  "goals",
                  "news",
                  "tax",
                  "clarify",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Classified Intent"
          },
          "executed_handler": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "finance_qa_node",
                  "tax_education_node",
                  "market_analysis_node",
                  "portfolio_analysis_node",
                  "goals_node",
                  "news_synthesizer_node",
                  "clarify_node",
                  "unsupported_node"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Executed Handler"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "calculation": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calculation"
          },
          "calculations": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calculations"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "citations": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Citations"
          },
          "thread_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thread Id"
          },
          "clarification_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clarification Question"
          }
        },
        "type": "object",
        "required": [
          "intent",
          "answer"
        ],
        "title": "QueryResponse"
      },
      "ResumeRequest": {
        "properties": {
          "thread_id": {
            "type": "string",
            "minLength": 1,
            "title": "Thread Id"
          },
          "reply": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Reply"
          }
        },
        "type": "object",
        "required": [
          "thread_id",
          "reply"
        ],
        "title": "ResumeRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "PortfolioManager": {
        "properties": {
          "manager_id": {
            "type": "string",
            "title": "Manager Id"
          },
          "manager_name": {
            "type": "string",
            "title": "Manager Name"
          }
        },
        "type": "object",
        "required": [
          "manager_id",
          "manager_name"
        ],
        "title": "PortfolioManager"
      },
      "PortfolioManagerDirectory": {
        "properties": {
          "managers": {
            "items": {
              "$ref": "#/components/schemas/PortfolioManager"
            },
            "type": "array",
            "title": "Managers"
          },
          "current_manager_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Manager Id"
          },
          "can_switch": {
            "type": "boolean",
            "title": "Can Switch",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "managers"
        ],
        "title": "PortfolioManagerDirectory"
      }
    }
  }
}
