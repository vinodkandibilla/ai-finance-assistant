[Unit]
Description=FinPilot Streamlit frontend
After=network-online.target finpilot-api.service
Wants=network-online.target finpilot-api.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/finpilot
Environment=FINPILOT_API_BASE_URL=http://127.0.0.1:8000
ExecStart=/home/ubuntu/finpilot/.venv/bin/python -m streamlit run src/finassist/web_app/app.py --server.address=0.0.0.0 --server.port=8501 --server.headless=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
